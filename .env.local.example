# Radar de Concorrentes — copie para .env.local e preencha
# A publishable é usada pelo login no navegador; a secret fica só no servidor.

# Supabase (supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RADAR_ALLOWED_EMAIL=

# AnyAPI — coleta inteira: Instagram, YouTube, site e anúncios (getanyapi.com → Dashboard → API Keys)
ANYAPI_KEY=

# Opcional — Insights IA (/posicionamento). Sem ela o app funciona; só as análises ficam desativadas.
ANTHROPIC_API_KEY=

# Só no deploy (Vercel) — protege a rota do cron semanal
# CRON_SECRET=
